{
  "name": "@plone-collective/volto-blog",
  "version": "1.0.0-alpha.0",
  "description": "@plone-collective/volto-blog adds blogging features to a Plone site.",
  "main": "src/index.ts",
  "license": "MIT",
  "keywords": [
    "volto-addon",
    "volto",
    "plone",
    "react"
  ],
  "author": "jnptk",
  "homepage": "https://github.com/collective/collective.blog",
  "repository": {
    "type": "git",
    "url": "git@github.com:collective/collective.blog.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
