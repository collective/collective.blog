  },
  "dependencies": {
    "@plone/components": "workspace:*"
  },
  "peerDependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-intl": "^3.12.1",
    "react-redux": "^8.1.2",
    "react-router-dom": "^5.2.0"
  }
